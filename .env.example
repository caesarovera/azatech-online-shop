# Opsional — docker-compose.yml sudah punya default untuk lokal.
# Salin ke .env lalu ubah jika perlu:  cp .env.example .env

# Untuk production WAJIB diisi (php artisan key:generate --show). Jika kosong, container membuat key sementara.
APP_KEY=
APP_ENV=production
APP_DEBUG=false

DB_DATABASE=azatech
DB_USERNAME=azatech
DB_PASSWORD=azatech-local

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
SANCTUM_EXPIRATION=480
