APP_NAME="Azatech Online Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
FRONTEND_URL=http://localhost:5173

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

# json = structured logging ke stderr (dipakai di Docker). Untuk lokal boleh "stack".
LOG_CHANNEL=json
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=azatech
DB_USERNAME=azatech
DB_PASSWORD=change-me

# API stateless (Bearer token) → session tidak dipakai untuk auth.
SESSION_DRIVER=array

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=azatech_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Masa berlaku token Sanctum (menit)
SANCTUM_EXPIRATION=480
ORDER_RATE_LIMIT=30

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@azatech.local"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
